# Local MinIO settings. To work offline, copy these over the AWS_*/S3_*/LAKE_BUCKET
# lines in .env (and run start-minio.cmd). .env currently points at Cloudflare R2.
AWS_ACCESS_KEY_ID=lakeadmin
AWS_SECRET_ACCESS_KEY=lakeadmin123
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
LAKE_BUCKET=lake
S3_ENDPOINT=localhost:9000
S3_USE_SSL=false
